[Unit]
Description=Steamed Pi first-boot setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/steamed-pi/firstboot-done

[Service]
Type=oneshot
ExecStart=/opt/steamed-pi/image/steamed-pi-firstboot.sh
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
