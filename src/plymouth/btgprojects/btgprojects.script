# Black background, logo centered and scaled to fit the screen (the logo image has a pure black background).
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo.image = Image("logo.png");
sw = Window.GetWidth();
sh = Window.GetHeight();
iw = logo.image.GetWidth();
ih = logo.image.GetHeight();
scale = Math.Min(sw / iw, sh / ih);
logo.scaled = logo.image.Scale(iw * scale, ih * scale);
logo.sprite = Sprite(logo.scaled);
logo.sprite.SetX((sw - logo.scaled.GetWidth()) / 2);
logo.sprite.SetY((sh - logo.scaled.GetHeight()) / 2);
logo.sprite.SetZ(10);
