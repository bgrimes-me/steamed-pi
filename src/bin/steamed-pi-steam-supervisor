#!/usr/bin/python3 -I
"""Keeps Steam running in Console Mode (like a Steam Deck: closing Steam just restarts it).
If Steam keeps dying (more than SUP_MAX restarts within SUP_WINDOW seconds) the console gives up, leaves a notice for the
console menu, and switches to the desktop so there is always a usable screen. Env vars exist so this can be tested."""
import os, sys, time, subprocess, json
HOME = os.path.expanduser('~'); CACHE = os.environ.get('SUP_CACHE', HOME + '/.cache/steamed-pi'); os.makedirs(CACHE, exist_ok=True)
STEAM_CMD = os.environ.get('SUP_STEAM_CMD', HOME + '/.local/bin/steam -gamepadui').split()
PROC = os.environ.get('SUP_PROC', 'steam')
INTERVAL = float(os.environ.get('SUP_INTERVAL', '5')); GONE_CHECKS = int(os.environ.get('SUP_GONE', '4')); GRACE = float(os.environ.get('SUP_GRACE', '30'))
MAX_RESTARTS = int(os.environ.get('SUP_MAX', '3')); WINDOW = float(os.environ.get('SUP_WINDOW', '600'))
GIVEUP = os.environ.get('SUP_GIVEUP', HOME + '/.local/bin/steamed-pi-session-switch desktop').split()
SESSION = os.environ.get('SUP_SESSION_PROC', 'labwc')      # the compositor this supervisor belongs to; when it is gone the session is over
FLAG = CACHE + '/restarting'; NOTICE = CACHE + '/notice'
def log(*a): print(time.strftime('%H:%M:%S'), 'supervisor:', *a, flush=True)
def running(): return subprocess.run(['pgrep', '-x', PROC], capture_output=True).returncode == 0
def session_alive(): return not SESSION or subprocess.run(['pgrep', '-x', SESSION], capture_output=True).returncode == 0
def launch():
    log('starting', ' '.join(STEAM_CMD))
    try: subprocess.Popen(STEAM_CMD, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e: log('could not start Steam:', e)
def safety_net():
    try: return json.load(open(HOME + '/.config/steamed-pi/settings.json')).get('safety', 'desktop') != 'retry'
    except (OSError, ValueError): return True
def give_up(n):
    msg = ('Console mode could not keep Steam running (%d restarts in %d minutes), so the console switched to the desktop. '
           'Check Steam, then use Return to Gaming Mode.' % (n, WINDOW // 60))
    open(NOTICE, 'w').write(msg); log('giving up:', msg); subprocess.run(GIVEUP)
def main():
    launch(); time.sleep(GRACE); gone = 0; fails = []
    while True:
        if not session_alive(): log('console session is over, supervisor exiting'); return 0
        if running(): gone = 0
        else:
            restarting = os.path.exists(FLAG) and time.time() - os.path.getmtime(FLAG) < 150      # a deliberate restart in progress
            gone = 0 if restarting else gone + 1
            if gone >= GONE_CHECKS:
                now = time.time(); fails = [t for t in fails if now - t < WINDOW] + [now]
                log('Steam is gone (failure %d in the last %d s)' % (len(fails), WINDOW))
                if len(fails) > MAX_RESTARTS:
                    if safety_net(): give_up(len(fails) - 1); return 1
                    log('Steam keeps failing; the setting says keep retrying (waiting a minute)'); fails = []; time.sleep(60)
                if not session_alive(): continue
                launch(); gone = 0; time.sleep(GRACE)
        time.sleep(INTERVAL)
if __name__ == '__main__': sys.exit(main())
