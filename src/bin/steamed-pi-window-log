#!/usr/bin/python3 -I
"""Debug aid: log every new X11 window (title / class / size) to ~/.cache/steamed-pi/windows.log for 20 minutes."""
import subprocess, re, time, os
LOG = os.path.expanduser('~/.cache/steamed-pi/windows.log'); seen = set(); end = time.time() + 1200
os.environ['DISPLAY'] = os.environ.get('DISPLAY', ':0')
while time.time() < end:
    out = subprocess.run(['xwininfo', '-root', '-tree'], capture_output=True, text=True).stdout
    for m in re.finditer(r'^\s+(0x[0-9a-f]+) (".*?"|\(has no name\)): \(("[^"]*" "[^"]*"|)\)\s+(\d+x\d+)\+(-?\d+)\+(-?\d+)', out, re.M):
        key = (m.group(2), m.group(3), m.group(4))
        if key not in seen:
            seen.add(key); open(LOG, 'a').write('%s id=%s title=%s class=%s size=%s pos=%s,%s\n' % (time.strftime('%H:%M:%S'), m.group(1), m.group(2), m.group(3), m.group(4), m.group(5), m.group(6)))
    time.sleep(0.4)
