#!/bin/bash
# RetroArch launcher for ES-DE under Steam.
# Uses the libretro nightly ARM64 build (desktop OpenGL; Ubuntu's package is GLES-only and can't run the
# N64/Dreamcast/PSP cores), falling back to the Ubuntu package.
# The Pi's GPU driver exposes GL 3.1; set RA_GL33=1 to advertise 3.3 (needed by mupen64plus_next). Default: real version.
BIN="$HOME/Applications/RetroArch-nightly/retroarch"; [ -x "$BIN" ] || BIN=/usr/bin/retroarch
if [ "$RA_GL33" = 1 ]; then export MESA_GL_VERSION_OVERRIDE=3.3 MESA_GLSL_VERSION_OVERRIDE=330
else unset MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE; fi
exec "$BIN" "$@"
