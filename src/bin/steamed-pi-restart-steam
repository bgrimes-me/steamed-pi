#!/bin/bash
# Restart the Steam client in the logged-in graphical session (used by the dashboard and the console menu).
U=$(id -u); mkdir -p ~/.cache/steamed-pi; touch ~/.cache/steamed-pi/restarting
export XDG_RUNTIME_DIR=/run/user/$U DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$U/bus DISPLAY=${DISPLAY:-:0}
[ -z "${WAYLAND_DISPLAY:-}" ] && export WAYLAND_DISPLAY=wayland-0
A=$(ls -t /run/user/$U/.mutter-Xwaylandauth.* 2>/dev/null | head -1); [ -n "$A" ] && export XAUTHORITY=$A
"$HOME/.local/bin/steam" -shutdown >/dev/null 2>&1
for i in $(seq 1 30); do pgrep -x steam >/dev/null || break; sleep 2; done
setsid "$HOME/.local/bin/steam" >/dev/null 2>&1 &
sleep 20; rm -f ~/.cache/steamed-pi/restarting
