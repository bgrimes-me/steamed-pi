[Desktop Entry]
Name=Steam
Comment=Valve's native ARM64 Steam client
Exec=@HOME@/.local/bin/steam %U
Icon=steam-native
Terminal=false
Type=Application
Categories=Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
StartupWMClass=steam
Actions=Library;Store;BigPicture;

[Desktop Action Library]
Name=Library
Exec=@HOME@/.local/bin/steam steam://open/games

[Desktop Action Store]
Name=Store
Exec=@HOME@/.local/bin/steam steam://store

[Desktop Action BigPicture]
Name=Big Picture
Exec=@HOME@/.local/bin/steam steam://open/bigpicture
